{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lattice.invalid/schema/policy-v1.schema.json",
  "title": "Heddle policy schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "meta", "roles", "rules"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["inherits", "ceiling"],
        "properties": {
          "inherits": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "ceiling": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "overrides": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action", "effect", "band", "authority"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "effect": { "enum": ["ALLOW", "DENY", "BARRIER"] },
          "band": { "enum": ["BARRIER", "EXPLICIT", "INHERITED_GRANT", "NAMESPACE_DEFAULT"] },
          "authority": { "enum": ["NETWORK", "SPATIAL", "ROLE", "PLUGIN", "NAMESPACE"] },
          "role": { "type": "string" },
          "subject": { "type": "string", "format": "uuid" },
          "priority": { "type": "integer" },
          "guard": { "$ref": "#/$defs/guard" },
          "budget": { "$ref": "#/$defs/budget" }
        }
      }
    }
  },
  "$defs": {
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "world": { "$ref": "#/$defs/stringSet" },
        "region": { "$ref": "#/$defs/stringSet" },
        "healthState": { "$ref": "#/$defs/stringSet" },
        "gameMode": { "$ref": "#/$defs/stringSet" },
        "networkPersona": { "$ref": "#/$defs/stringSet" },
        "plugin": { "type": "object", "additionalProperties": { "$ref": "#/$defs/stringSet" } },
        "notBefore": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zone", "days", "start", "end"],
          "properties": {
            "zone": { "type": "string" },
            "days": { "type": "array", "minItems": 1, "items": { "enum": ["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY", "SATURDAY", "SUNDAY"] }, "uniqueItems": true },
            "start": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
            "end": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" }
          }
        }
      }
    },
    "stringSet": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity", "refillTokens", "refillPeriodSeconds"],
      "properties": {
        "capacity": { "type": "integer", "minimum": 1 },
        "refillTokens": { "type": "integer", "minimum": 1 },
        "refillPeriodSeconds": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
